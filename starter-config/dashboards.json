    "css": "\n/* Dashboard Container Only - Scoped Background */\n.grid-stack {\n    background: linear-gradient(135deg, #f0fdf4 0%, #ffffff 100%) !important; /* Mint to White */\n    border-radius: 20px;\n    padding: 30px !important; /* More breathing room around edges */\n}\n\n/* Base Widget Style - Clean White */\n.grid-stack-item-content {\n    background-color: #ffffff !important;\n    border: 1px solid rgba(0,0,0,0.03) !important;\n    border-radius: 24px !important;\n    box-shadow: 0 15px 35px rgba(0,0,0,0.05), 0 5px 15px rgba(0,0,0,0.03) !important;\n    transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1), box-shadow 0.3s ease;\n}\n\n.grid-stack-item-content:hover {\n    transform: translateY(-5px);\n    box-shadow: 0 20px 40px rgba(0,0,0,0.08), 0 10px 20px rgba(0,0,0,0.05) !important;\n}\n\n/* Widget Header - Clean & Minimal */\n.widget-header {\n    background: transparent !important;\n    border-bottom: none !important;\n    padding: 20px 25px 5px 25px !important;\n    color: #475569;\n    font-size: 0.9rem;\n    font-weight: 700;\n    letter-spacing: 0.5px;\n}\n\n.widget-content {\n    padding: 10px 25px 25px 25px !important;\n    color: #334155;\n}\n\n/* Make gaps feel wider by adding internal margin to content */\n/* GridStack handles outer positioning, we use this for inner spacing feel */\n",
    "is_template": true
  },
